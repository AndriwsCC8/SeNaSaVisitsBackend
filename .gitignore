.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editores / IDE
.vscode/
.idea/

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# Alembic (mantener migraciones, ignorar solo archivos temporales si aplica)
