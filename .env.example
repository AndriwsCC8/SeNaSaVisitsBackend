# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a Git.

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Información general de la aplicación
APP_NAME=SeNaSa Visits API
API_V1_PREFIX=/api

# SQL Server (mediante PyODBC). Desarrollo local con autenticación integrada
# de Windows y Shared Memory; no agregues usuario ni contraseña aquí.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3Dlpc%3Alocalhost%3BDATABASE%3DSeNaSaVisitsDB%3BTrusted_Connection%3Dyes%3BEncrypt%3Dno%3B

# JWT (autenticación futura)
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS - orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://localhost:8443,http://127.0.0.1:8443,https://127.0.0.1:8443
